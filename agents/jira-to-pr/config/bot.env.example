# Copy this file to .env at the repository root and fill in the values.
# Never commit .env to version control.

TARGET_ENV=local

# Jira credentials (your own account is fine for the local MVP)
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@brightlocal.com
JIRA_API_TOKEN=

# GitHub Personal Access Token — needs scopes: repo (read+write), pull_requests
# Create at https://github.com/settings/tokens
GH_TOKEN=ghp_...

# Poller tuning
POLL_INTERVAL_SEC=300
RUN_TIMEOUT_MIN=90
MAX_TURNS=
# JIRA_JQL=project = LM AND sprint in openSprints() AND labels = AI AND status != Done ORDER BY created ASC

# Host ids used for the container user and docker socket access
HOST_UID=1000
HOST_GID=1000
HOST_DOCKER_GID=999

# Shared secret for the manual /run-agent endpoint.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
